DATABASE_URL=postgresql://user:pass@localhost:5432/terraos
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
BRIDGE_BASE_URL=http://localhost:8100
WEB_URL=http://localhost:3001
TYPEORM_SYNCHRONIZE=true
PORT=4000

# ── Demo mode ──────────────────────────────────────────────────────────────
# When true: seeds 3 simulated robots + demo accounts, exposes /api/v1/demo/*,
# and routes simulated-robot mission control to the scenario player.
DEMO_MODE=false
SCENARIO_PLAYER_URL=http://localhost:8300
# Bridge URLs for the three simulators (one process each).
SIM_UGV_URL=http://localhost:8200
SIM_CART_URL=http://localhost:8201
SIM_DRONE_URL=http://localhost:8202
# Demo account passwords (override the built-in dev defaults in any shared env).
DEMO_VIEWER_PASSWORD=demo-viewer
DEMO_OPERATOR_PASSWORD=demo-operator
